---
const now = new Date().toISOString();
const name = Astro.url.searchParams.get("name") ?? "world";
---
<html lang="en">
	<head><meta charset="utf-8" /><title>Astro v6 + apphosting-adapter</title></head>
	<body>
		<h1>Astro v6 + apphosting-adapter</h1>
		<p id="ssr-time">{now}</p>
		<p id="ssr-name">Hello, {name}!</p>
	</body>
</html>
